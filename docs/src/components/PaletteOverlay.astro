---
/*
 * The palette overlay: markup, its driving script, and its styles.
 *
 * This deliberately does NOT live in the ThemeProvider override. Starlight
 * renders ThemeProvider inside <head> (Page.astro), where the default
 * implementation is only a script and a <template> — both legal there. Emitting
 * a <div> from it implicitly closes <head> at that point, which pushed the main
 * stylesheet link into <body>, where it no longer blocks the first paint. The
 * result was a visible flash of unstyled header on every navigation.
 *
 * Rendered from Footer.astro instead, which appears exactly once per page on
 * both the splash and doc templates.
 */
import { defaults, modeMap, palettes, storageKey } from '../palettes.mjs';

const groups = [
  { mode: 'dark', items: palettes.filter((p) => p.mode === 'dark') },
  { mode: 'light', items: palettes.filter((p) => p.mode === 'light') },
];

const script = `(function(){
var M=${JSON.stringify(modeMap)},D=${JSON.stringify(defaults)},K=${JSON.stringify(storageKey)};
var overlay=document.getElementById("den-palette-overlay");
var list=document.getElementById("den-palette-list");
if(!overlay||!list)return;
var options=Array.prototype.slice.call(list.querySelectorAll("[role='option']"));
var media=window.matchMedia("(prefers-color-scheme: light)");
var root=document.documentElement;

function fallback(){return media.matches?D.light:D.dark}
function stored(){var s=localStorage.getItem(K);return s&&M[s]?s:null}
function active(){return stored()||fallback()}
var committed=active();

function apply(id){root.dataset.palette=id;root.dataset.theme=M[id]}
function sync(id){
  options.forEach(function(o){o.setAttribute("aria-selected",String(o.dataset.value===id))});
  var hit=options.find(function(o){return o.dataset.value===id});
  if(hit)Array.prototype.forEach.call(document.querySelectorAll(".den-palette-label"),function(el){
    el.textContent=hit.textContent.trim()});
}
function preview(i){
  if(i<0||i>=options.length)return;
  var id=options[i].dataset.value;apply(id);sync(id);options[i].focus();
}
function commit(id){apply(id);localStorage.setItem(K,id);committed=id;sync(id);close()}
function revert(){apply(committed);sync(committed);close()}
function open(){
  committed=active();
  overlay.hidden=false;document.body.style.overflow="hidden";sync(committed);
  var sel=list.querySelector("[aria-selected='true']")||options[0];
  if(sel)sel.focus();
}
function close(){overlay.hidden=true;document.body.style.overflow=""}
function toggle(){overlay.hidden?open():close()}

media.addEventListener("change",function(){if(!stored()){apply(fallback());sync(fallback())}});
options.forEach(function(o,i){
  o.addEventListener("click",function(){commit(o.dataset.value)});
  o.addEventListener("mouseenter",function(){preview(i)});
});
document.addEventListener("keydown",function(e){
  if((e.key==="t"||e.key==="/")&&!e.ctrlKey&&!e.metaKey&&!e.altKey){
    var t=document.activeElement&&document.activeElement.tagName;
    if(t==="INPUT"||t==="TEXTAREA"||t==="SELECT")return;
    e.preventDefault();toggle();return;
  }
  if(overlay.hidden)return;
  var i=options.indexOf(document.activeElement);
  if(e.key==="ArrowDown"){e.preventDefault();preview(i>=0?Math.min(options.length-1,i+1):0)}
  else if(e.key==="ArrowUp"){e.preventDefault();preview(i>=0?Math.max(0,i-1):options.length-1)}
  else if(e.key==="Enter"&&i>=0){e.preventDefault();commit(options[i].dataset.value)}
  else if(e.key==="Escape"){e.preventDefault();revert()}
});
overlay.addEventListener("click",function(e){if(e.target===overlay)revert()});
document.addEventListener("click",function(e){
  if(e.target.closest&&e.target.closest(".den-palette-trigger")){e.preventDefault();toggle()}
});
window.StarlightThemeProvider={updatePickers:function(){}};
// The trigger labels live in the header and mobile menu, which render after
// this script, so the first sync waits for them.
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",function(){sync(active())});
else sync(active());
})();`;
---

<div class="den-palette-overlay" id="den-palette-overlay" hidden>
  <div class="panel" role="dialog" aria-label="Palette switcher" aria-modal="true">
    <div class="title">palette</div>
    <div class="list" id="den-palette-list" role="listbox" aria-label="Palettes">
      {
        groups.map((g) => (
          <>
            <div class="sep"><span>{g.mode}</span></div>
            {g.items.map((p) => (
              <button type="button" role="option" data-value={p.id}>{p.label}</button>
            ))}
          </>
        ))
      }
    </div>
    <div class="foot">
      <span><kbd>↑↓</kbd> select</span>
      <span><kbd>↵</kbd> apply <kbd>esc</kbd> close</span>
    </div>
  </div>
</div>

{/* Must follow the markup above: the script resolves its elements synchronously. */}
<script is:inline set:html={script}></script>

<style>
  .den-palette-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sl-color-backdrop-overlay);
    backdrop-filter: blur(2px);
  }

  .den-palette-overlay[hidden] {
    display: none;
  }

  .panel {
    width: min(22rem, 92vw);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 4px;
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-lg);
    font-family: var(--sl-font-mono, var(--__sl-font-mono));
    font-size: var(--sl-text-sm);
    overflow: hidden;
  }

  .title {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-white);
  }

  .list {
    max-height: min(24rem, 60vh);
    overflow-y: auto;
    padding: 0.25rem 0;
  }

  .sep {
    padding: 0.5rem 0.75rem 0.25rem;
    color: var(--sl-color-gray-4);
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .list button {
    display: block;
    width: 100%;
    padding: 0.3rem 0.75rem 0.3rem 1.5rem;
    border: 0;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    text-align: start;
    cursor: pointer;
    position: relative;
  }

  .list button:hover,
  .list button:focus-visible {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    outline: none;
  }

  .list button[aria-selected='true']::before {
    content: '>';
    position: absolute;
    inset-inline-start: 0.6rem;
    color: var(--sl-color-accent);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.75rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-2xs);
  }

  kbd {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 2px;
    padding: 0 0.25rem;
    color: var(--sl-color-gray-2);
  }
</style>
